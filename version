function renderChart(c){
  const lg = SILK_PORTS.map((p,i)=>
    `<div class="chart-lg"><img src="${c.legend[i]}" alt="${p.nm}"><span class="cp">${p.pl}</span></div>`).join('');
  return `<div class="chart-wrap" id="silkChart">
    <div class="chart-map"><img src="${c.map}" alt="海上丝绸之路航路图" width="850" height="1214">
      <svg viewBox="0 0 100 142.9" aria-hidden="true">
        <path class="chart-route" d="${c.d}"/>
        <path class="chart-draw" d="${c.d}"/>
        <g class="chart-boat"><path d="M -2.1 1.1 L 2.5 1.1 L 1.5 2.5 L -1.3 2.5 Z" fill="#0d5f7e" stroke="#fbfaf7" stroke-width=".22"/><path d="M -0.1 .8 L -0.1 -2.7 L 2 .8 Z" fill="#b98a2f" stroke="#fbfaf7" stroke-width=".22"/><path d="M -0.55 .8 L -0.55 -2 L -2 .8 Z" fill="#274b63" stroke="#fbfaf7" stroke-width=".22"/></g>
      </svg>
    </div>
    <div class="chart-legend">${lg}</div>
  </div>`;
}
let silkUpd = null, silkBound = false;
function bindChartScroll(){
  const wrap = document.getElementById('silkChart');
  if (!wrap) return;
  const draw = wrap.querySelector('.chart-draw');
  const boat = wrap.querySelector('.chart-boat');
  const svg  = wrap.querySelector('svg');
  if (!draw) return;
  const L = draw.getTotalLength();
  draw.style.strokeDasharray = L;
  draw.style.strokeDashoffset = L;
  const NS = 'http://www.w3.org/2000/svg';
  const portEls = SILK_PORTS.map(p=>{
    const pt = draw.getPointAtLength(p.f*L);
    const left = pt.x > 60;
    const g = document.createElementNS(NS,'g');
    g.setAttribute('class','chart-port');
    const ci = document.createElementNS(NS,'circle');
    ci.setAttribute('cx',pt.x); ci.setAttribute('cy',pt.y); ci.setAttribute('r',1.05);
    const nm = document.createElementNS(NS,'text');
    nm.setAttribute('x', pt.x + (left?-2.2:2.2)); nm.setAttribute('y', pt.y - .4);
    if (left) nm.setAttribute('text-anchor','end');
    nm.setAttribute('class','nm'); nm.textContent = p.nm;
    const pl = document.createElementNS(NS,'text');
    pl.setAttribute('x', pt.x + (left?-2.2:2.2)); pl.setAttribute('y', pt.y + 2.5);
    if (left) pl.setAttribute('text-anchor','end');
    pl.setAttribute('class','pl'); pl.textContent = p.pl;
    g.append(ci,nm,pl); svg.appendChild(g);
    return g;
  });
  const lgEls = [...wrap.querySelectorAll('.chart-lg')];
  const setP = p=>{
    draw.style.strokeDashoffset = L*(1-p);
    const pt  = draw.getPointAtLength(p*L);
    const pt2 = draw.getPointAtLength(Math.min(L-.01, p*L+2));
    const ang = Math.atan2(pt2.y-pt.y, pt2.x-pt.x)*180/Math.PI;
    boat.setAttribute('transform', `translate(${pt.x.toFixed(2)} ${pt.y.toFixed(2)}) rotate(${ang.toFixed(1)})`);
    boat.classList.add('on');
    portEls.forEach((el,i)=>el.classList.toggle('on', p>=SILK_PORTS[i].f-1e-4));
    lgEls.forEach((el,i)=>el.classList.toggle('on', p>=SILK_PORTS[i].f-1e-4));
  };
  if (reduced){ setP(1); return; }
  silkUpd = ()=>{
    if (!wrap.isConnected){ silkUpd = null; return; }
    const r  = wrap.getBoundingClientRect();
    const vh = innerHeight || 800;
    const total = r.height + vh*.5;
    setP(Math.max(0, Math.min(1, (vh*.85 - r.top)/total)));
  };
  if (!silkBound){
    ovScroll.addEventListener('scroll', ()=>{ if (silkUpd) requestAnimationFrame(silkUpd); }, {passive:true});
    silkBound = true;
  }
  requestAnimationFrame(silkUpd);
}

function renderBlocks(blocks){
  let html = '';
  blocks.forEach(b=>{
    /* 动态地图画布 */
    if (b.map){ html += renderMap(b.map); return; }
    /* 全册总览缩略表:整齐网格,点击跳到对应页 */
    if (b.ov){
      const n = b.ov.n, pre = b.ov.t || 'assets/memory-thumbs/t';
      let g = `<div class="ovt-grid">` + Array.from({length:n},(_,i)=>{
        const no = i+1;
        return `<figure class="ovt" data-goto="${no}" title="跳到 P.${String(no).padStart(2,'0')}">` +
          `<img loading="lazy" src="${pre}${String(no).padStart(2,'0')}.jpg" alt="P.${String(no).padStart(2,'0')}">` +
          `<span class="ovt-no">${String(no).padStart(2,'0')}</span></figure>`;
      }).join('') + `</div>`;
      html += b.h ? `<div class="ov-sec"${b.key?` id="sec-${b.key}"`:''}><h3>${b.h}</h3>${g}</div>` : g;
      return;
    }
    /* 航海图航线(滚动驱动) */
    if (b.chart){ html += renderChart(b.chart); return; }
    const h3 = b.himg
      ? `<h3 class="h-img"><img src="${b.himg}" alt="">${b.hs?`<span class="hs">${b.hs}</span>`:''}</h3>`
      : (b.h ? `<h3>${b.h}</h3>` : '');
    html += `<div class="ov-sec"${b.key?` id="sec-${b.key}"`:''}>${h3}`;
    /* 案例小标题:图文对应分组 */
    if (b.st) html += `<h4 class="ov-st">${b.st}</h4>`;
    /* 结语:逐行散文诗 */
    if (b.ln) html += `<p class="ov-ln">` + b.ln.map(s=>`<span class="ln">${s}</span>`).join('') + `</p>`;
    if (b.fig){
      html += `<figure class="ov-fig" data-zoom="${b.fig[0]}"><img loading="lazy" src="${b.fig[0]}" data-pi="${pi()}"${b.fig[2]?` width="${b.fig[2]}" height="${b.fig[3]}"`:''}><figcaption>${b.fig[1]}</figcaption></figure>`;
    }
    if (b.p) [].concat(b.p).forEach(t=>{ html += `<p>${sent(t)}</p>`; });
    /* 静态完整图(不可放大) */
    if (b.img){
      html += `<figure class="ov-full"><img loading="lazy" src="${b.img}" data-pi="${pi()}">` +
              (b.icap?`<figcaption>${b.icap}</figcaption>`:'') + `</figure>`;
    }
    if (b.grid){
      html += `<div class="ov-grid${b.art?' ov-grid--art':''}${b.fix?' ov-grid--fix':''}${b.tall?' ov-grid--tall':''}">` + b.grid.map(g=>
        `<figure${g[2]?` id="fig-${g[2]}"`:''} data-zoom="${g[0]}"><img loading="lazy" src="${g[0]}" data-pi="${pi()}"><figcaption>${g[1]}</figcaption></figure>`).join('') + `</div>`;
    }
    /* 设计元素陈列 */
    if (b.kit){
      html += `<div class="rm-kit">` + b.kit.map(g=>
        `<figure><img loading="lazy" src="${g[0]}" alt="${g[2]||g[1]}"><figcaption><b>${g[1]}</b>${g[2]||''}</figcaption></figure>`).join('') + `</div>`;
    }
    /* 信息图细部(可点击放大) */
    if (b.crops){
      html += `<div class="rm-crops">` + b.crops.map(g=>
        `<figure${g[2]?` id="fig-${g[2]}"`:''} data-zoom="${g[0]}"><img loading="lazy" src="${g[0]}" alt="${g[1]}" data-pi="${pi()}"><figcaption><b>${g[1]}</b>${g[3]||''}</figcaption></figure>`).join('') + `</div>`;
    }
    /* 分镜表 */
    if (b.shots){
      html += `<div class="rm-shots">` + b.shots.map(s=>
        `<div class="rm-shot"><span class="no">${s[0]}</span><span class="tm">${s[1]}</span><span class="tx">${s[2]}</span></div>`).join('') + `</div>`;
    }
    /* 视频 */
    if (b.video){
      html += `<div class="rm-video"><video controls playsinline preload="metadata"${b.poster?` poster="${b.poster}"`:''}>` +
              `<source src="${b.video}" type="video/mp4"></video></div>`;
      if (b.vcap) html += `<div class="rm-video-cap">${b.vcap}</div>`;
    }
    if (b.acts){
      b.acts.forEach(act=>{
        html += `<div class="ov-act"><div class="at">${act.t}</div>`;
        if (act.p) html += `<p>${sent(act.p)}</p>`;
        html += `<div class="act-grid">`;
        act.items.forEach(it=>{
          html += `<figure class="act-card"${it.im?` data-zoom="${it.im}"`:''}>` +
            (it.im?`<img loading="lazy" src="${it.im}" alt="${it.w}" data-pi="${pi()}">`:'') +
            `<figcaption><span class="iw">${it.w}</span>` +
            (it.a?`<span class="ia">${it.a}</span>`:'') +
            (it.d?`<div class="id">${it.d}</div>`:'') +
            `</figcaption></figure>`;
        });
        html += `</div></div>`;
      });
    }
    html += `</div>`;
  });
  return html;
}
function openOverlay(id){
  let d = DB[id];
  if (!d) return;
  /* 碎片 → 跳到它所属作品里的位置 */
  let anchor = null;
  if (d.home){ anchor = d.anchor || null; d = DB[d.home]; }
  if (!d || (!d.img && !d.pages && !d.blocks)) return;
  overlay.dataset.theme = d.theme || '';
  document.getElementById('ovTitle').textContent = d.title;
  document.getElementById('ovType').textContent  = d.type;
  document.getElementById('ovMeta').textContent  = d.meta || '';
  document.getElementById('ovDesc').textContent  = d.desc || '';
  document.getElementById('ovMeta').style.display = d.meta ? '' : 'none';
  document.getElementById('ovDesc').style.display = d.desc ? '' : 'none';

  piCount = 0;
  if (d.kind === 'work'){
    ovFlow.innerHTML = (d.lead ? renderBlocks(d.lead) : '') + renderWork(d) + (d.after ? renderBlocks(d.after) : '');
  } else if (d.kind === 'desert' || d.kind === 'roma'){
    ovFlow.innerHTML = renderBlocks(d.blocks);
  } else {
    ovFlow.innerHTML = `<div class="ov-page ov-page--solo"><img src="${d.img}" data-pi="${pi()}"></div>`;
  }
  /* 可放大查看的元素 */
  ovFlow.querySelectorAll('[data-zoom]').forEach(el=>{
    el.addEventListener('click',e=>{ e.stopPropagation(); openLight(el.dataset.zoom); });
  });
  /* 总览缩略图:点击跳到对应页 */
  ovFlow.querySelectorAll('.ovt').forEach(el=>{
    el.addEventListener('click',()=>scrollToAnchor('bk-'+el.dataset.goto));
  });
  bindMapParallax();
  collageDrop();
  bindBook();
  bindChartScroll();
  ovEnd.textContent = d.end || '';
  ovScroll.scrollTop = 0;
  overlay.classList.add('open');
  ovOpen = true;
  updateCounter();
  if (!reduced && hasGSAP){
    gsap.fromTo('#ovInfo',{y:26,opacity:0},{y:0,opacity:1,duration:0.8,ease:'power2.out'});
    if (!anchor){
      gsap.fromTo('#ovFlow > *',{y:44,opacity:0},
        {y:0,opacity:1,duration:0.9,ease:'power3.out',stagger:0.045,overwrite:true});
    }
  }
  if (anchor) scrollToAnchor(anchor);
}

/* 地图视差:阅读层内移动鼠标,按深度分层位移(对所有画布生效) */
let mapMoveOff = null;
function bindMapParallax(){
  if (mapMoveOff){ mapMoveOff(); mapMoveOff = null; }
  if (reduced || !hasGSAP || isMobile()) return;
  const maps = [...document.querySelectorAll('.rm-map')];
  if (!maps.length) return;
  const layers = [];
  maps.forEach(map=>{
    const bg = map.querySelector('.rm-bg');
    if (bg) layers.push({el:bg, d:0.4});
    map.querySelectorAll('.rm-el').forEach(el=>{
      if (el.classList.contains('still')) return;
      const z = parseFloat(el.style.getPropertyValue('--z'))||6;
      layers.push({el:el.querySelector('.pv'), d:0.45 + z*0.1});
    });
  });
  const setters = layers.map(L=>({
    x:gsap.quickTo(L.el,'x',{duration:0.9,ease:'power3.out'}),
    y:gsap.quickTo(L.el,'y',{duration:0.9,ease:'power3.out'}), d:L.d
  }));
  const onMove = e=>{
    const r = overlay.getBoundingClientRect();
    const nx = (e.clientX-r.left)/r.width - .5, ny = (e.clientY-r.top)/r.height - .5;
    setters.forEach(s=>{ s.x(nx*s.d*-24); s.y(ny*s.d*-18); });
  };
  overlay.addEventListener('mousemove', onMove);
  mapMoveOff = ()=>overlay.removeEventListener('mousemove', onMove);
}

/* ---- 手账拼贴入场:元素像被逐张「贴」到纸面上 ---- */
function collageDrop(){
  const maps = [...document.querySelectorAll('.rm-map.mm')];
  if (!maps.length) return;
  if (reduced || !hasGSAP){ bindMapParallax(); return; }
  let last = 0;
  maps.forEach((map, mi)=>{
    const els = [...map.querySelectorAll('.rm-el')];
    els.forEach((el, i)=>{
      const pv = el.querySelector('.pv');
      if (!pv) return;
      const rot = parseFloat(el.style.getPropertyValue('--rot'))||0;
      /* 延迟封顶 0.6s:19 页全册铺开时,靠后的画布不能等太久,否则快速滚动会看到「还没贴上」的空白纸面 */
      const base = Math.min(mi*0.12 + i*0.045, 0.6);
      if (el.classList.contains('still')){
        gsap.fromTo(pv,{opacity:0},{opacity:1,duration:0.55,delay:0.1+base,ease:'power2.out'});
        return;
      }
      /* 从上方带旋转落下 → 回正贴住纸面(back.out 给一点「按下去弹一下」的手感) */
      gsap.fromTo(pv,
        {yPercent:-8, opacity:0, rotation:rot-7, transformOrigin:'50% 55%'},
        {yPercent:0, opacity:1, rotation:rot, duration:0.78, ease:'back.out(1.35)', delay:0.12+base,
         onComplete:i===els.length-1?()=>bindMapParallax():null});
      last = Math.max(last, 0.12+base+0.78);
    });
  });
  /* 兜底:入场结束后重建视差(避免与入场补间在同属性上打架) */
  setTimeout(bindMapParallax, (last+0.05)*1000);
}

/* ---- 书籍感:版权页式页码 ----
   页(画布或静态页)滚进视口中带时,右下角浮现「P.07 / 19」小页码 */
let bkObs = null;
function bindBook(){
  if (bkObs){ bkObs.disconnect(); bkObs = null; }
  const hosts = ovFlow.querySelectorAll('[data-bk]');
  if (!hosts.length) return;
  bkObs = new IntersectionObserver(es=>{
    es.forEach(en=>{
      const pg = en.target.querySelector('.pgno');
      if (pg) pg.classList.toggle('on', en.isIntersecting);
    });
  }, {root:ovScroll, rootMargin:'-42% 0px -42% 0px', threshold:0});
  hosts.forEach(h=>bkObs.observe(h));
}

/* 定位到素材在作品里的位置,并闪一下边框 */
function scrollToAnchor(anchor){
  const jump = ()=>{
    const el = document.getElementById(anchor);
    if (!el) return;
    const top = el.getBoundingClientRect().top - ovScroll.getBoundingClientRect().top + ovScroll.scrollTop - 120;
    ovScroll.scrollTop = Math.max(top, 0);
    updateCounter();
  };
  [0,320,900].forEach(t=>setTimeout(jump,t));
  setTimeout(()=>{
    const el = document.getElementById(anchor);
    if (!el) return;
    el.classList.add('ov-hit');
    setTimeout(()=>el.classList.remove('ov-hit'), 1800);
  },1000);
}
function hideOverlay(instant){
  if (!ovOpen) return;
  const done = ()=>{
    overlay.classList.remove('open'); ovOpen=false; ovCounter.textContent='';
    overlay.dataset.theme='';
    ovFlow.querySelectorAll('video').forEach(v=>{ try{ v.pause(); }catch(e){} });
    if (mapMoveOff){ mapMoveOff(); mapMoveOff = null; }
  };
  if (instant || reduced || !hasGSAP){ done(); return; }
  gsap.to(ovScroll,{opacity:0,duration:0.28,ease:'power2.in',onComplete:()=>{
    gsap.set(ovScroll,{opacity:1}); done();
  }});
}

/* 阅读进度:显示当前阅读到第几"页" */
function updateCounter(){
  if (!ovOpen) return;
  const marks = ovFlow.querySelectorAll('[data-pi]');
  const total = marks.length;
  if (!total){ ovCounter.textContent=''; return; }
  const mid = ovScroll.getBoundingClientRect().top + innerHeight*0.55;
  let cur = 1;
  marks.forEach(m=>{
    if (m.getBoundingClientRect().top <= mid) cur = Math.max(cur, +m.dataset.pi);
  });
  ovCounter.textContent = String(cur).padStart(2,'0') + ' / ' + String(total).padStart(2,'0');
}
ovScroll.addEventListener('scroll',updateCounter,{passive:true});

/* ===== 沉浸看图(放大看细节) ===== */
const rmLight = document.getElementById('rmLight');
const rmLightImg = document.getElementById('rmLightImg');
const rmLightScroll = document.getElementById('rmLightScroll');
let lightOpen = false;
function openLight(src){
  if (!src) return;
  rmLightImg.src = src;
  rmLight.classList.add('on');
  lightOpen = true;
  setLightFit('fit');
  if (!reduced && hasGSAP) gsap.fromTo(rmLightImg,{opacity:0,y:20},{opacity:1,y:0,duration:.55,ease:'power2.out'});
}
function setLightFit(m){
  rmLight.classList.toggle('fit', m==='fit');
  rmLight.classList.toggle('full', m==='full');
  document.getElementById('rmFit').classList.toggle('on', m==='fit');
  document.getElementById('rmFull').classList.toggle('on', m==='full');
  if (m==='fit') rmLightScroll.scrollTop = 0;
}
function closeLight(){
  rmLight.classList.remove('on');
  lightOpen = false;
  setTimeout(()=>rmLightImg.removeAttribute('src'), 250);
}
document.getElementById('rmFit').addEventListener('click',()=>setLightFit('fit'));
document.getElementById('rmFull').addEventListener('click',()=>setLightFit('full'));
document.getElementById('rmLightClose').addEventListener('click',closeLight);
rmLightScroll.addEventListener('click',e=>{ if (e.target === rmLightScroll) closeLight(); });

document.getElementById('ovClose').addEventListener('click',()=>hideOverlay());
addEventListener('keydown',e=>{
  if (e.key !== 'Escape') return;
  if (lightOpen){ closeLight(); return; }
  hideOverlay();
});

/* 点击作品卡与资料卡(装饰碎片 .item--free 不可点) */
document.querySelectorAll('.item--work, .item--mat').forEach(el=>{
  el.addEventListener('click',()=>openOverlay(el.dataset.id));
});

/* 右上角索引 */
const idx = document.getElementById('idx');
document.getElementById('idxBtn').addEventListener('click',e=>{
  e.stopPropagation(); idx.classList.toggle('open');
});
document.addEventListener('click',e=>{ if(!idx.contains(e.target)) idx.classList.remove('open'); });
idx.querySelectorAll('[data-work]').forEach(a=>{
  a.addEventListener('click',()=>{
    idx.classList.remove('open');
    const w = a.dataset.work;
    if (document.body.dataset.page != 1){ gotoPage(1); setTimeout(()=>openOverlay(w),480); }
    else openOverlay(w);
  });
});

/* 启动 */
bindParallax();
pageIn(1);
