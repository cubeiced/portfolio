/* 书籍感页码:版权页样式「P.07 / 19」 */
const pgnoHTML = (n,t)=>`<div class="pgno"><i></i><span>P.${String(n).padStart(2,'0')} / ${t}</span></div>`;

function renderWork(d){
  /* pbook:开启书籍感页码(画册类作品),封面/画布占前几页计入总页数 */
  const book = !!d.pbook;
  const base = book ? (d.lead||[]).filter(b=>b.map&&b.map.no).length : 0;
  const tot  = book ? base + d.pages.length : 0;
  return d.pages.map((p,i)=>{
    const src = Array.isArray(p) ? p[0] : p;
    const r   = Array.isArray(p) ? p[1] : (d.pr || '');
    const st  = r ? ` style="aspect-ratio:${r}"` : '';
    const no  = book ? base+i+1 : 0;
    return `<div class="ov-page"${st}${no?` data-bk`:''}><img loading="lazy" src="${src}" alt="第${i+1}页" data-pi="${pi()}">${no?pgnoHTML(no,tot):''}</div>`;
  }).join('');
}
/* 正文按句切分,每句独立成行 */
const sent = t => String(t).split(/(?<=[。！？])/).map(s=>s.trim()).filter(Boolean)
  .map(s=>`<span class="ln">${s}</span>`).join('');

/* 罗马动态地图画布:分层素材 + 悬浮浮动 + 鼠标视差 */
function renderMap(m){
  const bgAll = m.bg||[], elAll = m.els||[];
  const bg = bgAll.filter(g=>g[4]!=='mul').map(g=>
    `<img src="${g[0]}" style="left:${g[1]}%;top:${g[2]}%;width:${g[3]}%" alt="">`).join('');
  /* 正片叠底层:海报纸色裁片(已漂白) */
  const mul = bgAll.filter(g=>g[4]==='mul').map(g=>
    `<img src="${g[0]}" class="mul" style="left:${g[1]}%;top:${g[2]}%;width:${g[3]}%" alt="">`).join('') +
    elAll.filter(e=>e.mul).map(e=>
    `<img src="${e.i}" class="mul" style="left:${e.x}%;top:${e.y}%;width:${e.w}%;z-index:${e.z||6}" alt="">`).join('');
  const isMM = m.cls === 'mm';
  const els = [].concat(elAll.filter(e=>!e.mul), (m.labs||[]).map(l=>Object.assign({lab:1}, l))).map((e,i)=>{
    const bd = (3.6 + (i%5)*0.45).toFixed(2), bl = (-(i*0.63)%2.4).toFixed(2);
    /* 手账拼贴:每个元素带一个固定的微小旋转(手工摆放不会全正) */
    const rot = (isMM && !e.still && !e.lab)
      ? ((((Math.round(e.x*13) + Math.round(e.y*7)) % 9) + 9) % 9 - 4) * 0.45 : 0;
    const inner = e.lab
      ? `<span class="lt">${e.t}</span>`
      : `<img loading="lazy" src="${e.i}"${e.sq?' class="sq"':''} alt="${e.n||''}">` + (e.n?`<i class="nm">${e.n}</i>`:'');
    return `<div class="rm-el${e.lab?' lab':''}${e.plain?' plain':''}${e.still?' still':''}" style="--x:${e.x}%;--y:${e.y}%;--w:${e.w}%;--z:${e.z||6};--hz:${e.hz||50};--bd:${bd}s;--bl:${bl}s;--rot:${rot.toFixed(2)}deg">` +
      `<div class="pv"><div class="mv"><div class="fl">${inner}</div></div></div></div>`;
  }).join('');
  const canvas = `<div class="rm-map${m.cls?' '+m.cls:''}" style="${m.paper?`background-image:url('${m.paper}')`:''}${m.ar?`;aspect-ratio:${m.ar}`:''}"${m.no?` id="bk-${m.no}" data-bk`:''}><div class="rm-mul">${mul}</div><div class="rm-bg">${bg}</div>${els}${m.no?pgnoHTML(m.no,m.pt):''}</div>`;
  /* 带并排海报:完整信息图(左) + 动态地图(右) */
  if (m.side){
    const s = m.side;
    return `<div class="rm-duo">` +
      `<figure class="rm-poster" data-zoom="${s.src}">` +
        `<img loading="lazy" src="${s.src}" alt="${(s.cap||'').replace(/<[^>]+>/g,'')}" data-pi="${pi()}">` +
        (s.cap?`<figcaption>${s.cap}</figcaption>`:'') +
      `</figure>` + canvas + `</div>`;
  }
  return `<div class="rm-hero">${canvas}</div>`;
}

