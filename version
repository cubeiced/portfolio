<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>曾琦涵 — 档案空间 | AI 产品 & 内容</title>
<style>
:root{
  --ink:#000;
  --paper:#fff;
  --gray-1:#666;
  --gray-2:#9a9a9a;
  --line:#e6e6e6;
  --mat:#f0f0ee;
  --reader:#f4f4f2;
  --ease:cubic-bezier(0.16,1,0.3,1);
  --serif:'Noto Serif SC','Source Han Serif SC','Songti SC',SimSun,serif;
  --sans:'Noto Sans SC','Source Han Sans SC','Microsoft YaHei',sans-serif;
}
*{margin:0;padding:0;box-sizing:border-box}
html,body{height:100%}
body{
  font-family:var(--sans);
  background:var(--paper);
  color:var(--ink);
  font-size:15px;
  line-height:1.8;
  overflow:hidden;
  -webkit-font-smoothing:antialiased;
}
a{color:inherit;text-decoration:none}
img{display:block;max-width:100%}

/* ============ 顶部(详情层打开时仍可见) ============ */
header{
  position:fixed;top:0;left:0;right:0;z-index:90;
  display:flex;justify-content:center;align-items:center;gap:14px;
  padding:22px 32px;
}
.logo{font-weight:700;font-size:15px;letter-spacing:.02em;margin-right:10px}
.pager{display:flex;align-items:center;gap:8px}
.space-label{
  font-family:var(--serif);font-size:14px;letter-spacing:.02em;
  background:#f2f2f0;border-radius:7px;padding:7px 18px;cursor:default;
}
.space-label sup{font-size:9px;color:var(--gray-2);margin-left:5px;font-family:var(--sans)}
.pg{
  font-size:13px;min-width:34px;text-align:center;
  background:#f2f2f0;border:none;border-radius:7px;padding:7px 0;
  cursor:pointer;font-family:var(--sans);color:var(--ink);
  transition:background .35s var(--ease),color .35s var(--ease);
}
.pg:hover{background:#e6e6e4}
.pg.on{background:#111;color:#fff}

/* ============ 画布:一屏散落,全部水平对齐 ============ */
.space{position:absolute;inset:0;overflow:hidden}
.space[data-page="2"]{visibility:hidden}
body[data-page="2"] .space[data-page="1"]{visibility:hidden}
body[data-page="2"] .space[data-page="2"]{visibility:visible}
/* 档案空间 P2:竖向滚动的散落拼贴画布 */
.space[data-page="2"]{overflow-y:auto;overflow-x:hidden;scrollbar-width:none}
.space[data-page="2"]::-webkit-scrollbar{display:none}
.p2-canvas{position:relative;height:2860px}
#pv{position:fixed;inset:0;background:rgba(24,21,17,.93);display:flex;align-items:center;justify-content:center;opacity:0;pointer-events:none;transition:opacity .35s;z-index:120;cursor:zoom-out}
#pv.on{opacity:1;pointer-events:auto}
#pv img{max-width:92vw;max-height:92vh;box-shadow:0 18px 60px rgba(0,0,0,.5)}

.item{position:absolute;left:var(--x);top:var(--y);width:var(--w);cursor:pointer;z-index:var(--z,1)}
.item-inner{will-change:transform;position:relative}
.item--mat .item-inner{background:var(--mat);padding:clamp(10px,1.2vw,20px)}
.item--mat .item-inner .ph{overflow:hidden;background:#e8e8e6}
/* 透明底素材:不加任何底卡,直接浮在页面上 */
.item--cut .item-inner{background:none;padding:0}
.item--cut .item-inner .ph{background:none;overflow:visible}
.item--cut:hover .ph{opacity:.7}
.item-inner .ph img{width:100%;height:auto}
/* 竖版海报适配:卡片保持 3:2 占位,海报完整 contain 居中,底色与海报米边同色 */
.item-inner .ph--fit img{aspect-ratio:3/2;object-fit:contain;background:#f6ecd1}
.item--free .item-inner img{width:100%;height:auto}
.item:hover{z-index:60}
.item--mat:hover .ph{opacity:.7}
.item .ph,.item--free{transition:opacity .35s var(--ease)}
.item--note{cursor:default}
/* 装饰碎片:纯装饰,不可点 */
.item--free{cursor:default}
/* 作品展签 */
.item--work .tag{
  margin-top:10px;font-size:10.5px;letter-spacing:.1em;color:var(--gray-1);
  display:flex;align-items:baseline;gap:9px;
}
.item--work .tag b{font-weight:700;font-size:9.5px;letter-spacing:.2em;color:var(--ink)}
.item--work .tag i{font-style:normal;font-size:9.5px;letter-spacing:.08em;color:var(--gray-2);margin-left:auto;text-align:right}
/* 右上角索引 */
.idx{position:fixed;right:32px;top:22px;z-index:95}
.idx-btn{
  font-family:var(--serif);font-size:14px;letter-spacing:.06em;
  background:#f2f2f0;border:none;border-radius:7px;padding:7px 16px;cursor:pointer;
  transition:background .35s var(--ease);
}
.idx-btn:hover{background:#e6e6e4}
.idx-panel{
  position:absolute;right:0;top:calc(100% + 10px);min-width:300px;
  background:#fff;border:1px solid var(--line);box-shadow:0 14px 38px rgba(0,0,0,.1);
  padding:8px;display:none;
}
.idx.open .idx-panel{display:block}
.idx-panel a{
  display:flex;align-items:baseline;gap:11px;padding:11px 12px;cursor:pointer;
  transition:background .25s var(--ease);
}
.idx-panel a:hover{background:#f5f5f3}
.idx-panel b{font-size:9.5px;font-weight:700;color:var(--gray-2);letter-spacing:.2em}
.idx-panel span{font-family:var(--serif);font-size:13.5px;letter-spacing:.04em}
.idx-panel i{font-style:normal;font-size:9.5px;color:var(--gray-2);margin-left:auto;letter-spacing:.06em}
.item--hero .item-inner{padding:clamp(14px,1.6vw,26px)}

/* 文字卡 */
.note-card{background:#fff;padding:24px 24px 20px;border:1px solid var(--line)}
.note-card .q{font-family:var(--serif);font-size:15px;line-height:2;letter-spacing:.03em}
.note-card .a{margin-top:12px;font-size:10px;letter-spacing:.22em;color:var(--gray-2)}
.contact-card .q{font-size:14px}
.contact-card a{border-bottom:1px solid var(--ink);padding-bottom:2px;transition:opacity .35s}
.contact-card a:hover{opacity:.55}
.deco-on-card{position:absolute;pointer-events:none}

/* ============ 作品阅读层:可滑动翻完 ============ */
.overlay{
  position:fixed;inset:0;z-index:80;background:var(--reader);
  visibility:hidden;opacity:0;
  transition:opacity .35s var(--ease);
}
.overlay.open{visibility:visible;opacity:1}
.ov-close{
  position:fixed;left:28px;top:34vh;z-index:210;
  background:none;border:none;cursor:pointer;
  font-size:13px;font-weight:700;font-family:var(--sans);
  padding:6px 10px;letter-spacing:.02em;
  color:#fff;mix-blend-mode:difference;
  transition:opacity .35s var(--ease);
}
.ov-close:hover{opacity:.5}
.ov-scroll{
  position:absolute;inset:0;overflow-y:auto;overscroll-behavior:contain;
  -webkit-overflow-scrolling:touch;
  padding:96px 24px 90px;
}
/* 信息头 */
.ov-info{max-width:640px;margin:0 auto 44px;text-align:center;cursor:pointer}
.ov-info .t{font-family:var(--serif);font-size:21px;letter-spacing:.04em}
.ov-info .ty{font-size:11px;letter-spacing:.26em;color:var(--gray-2);margin-top:9px}
.ov-info .m{font-size:11px;color:var(--gray-2);margin-top:9px;letter-spacing:.08em}
.ov-info .d{font-size:13px;color:var(--gray-1);line-height:2.05;margin-top:16px}
/* 内页流 */
.ov-flow{max-width:min(860px,94vw);margin:0 auto}
.ov-page{position:relative;background:#fff;box-shadow:0 1px 3px rgba(0,0,0,.07);margin-bottom:16px;overflow:hidden}.ov-page img{width:100%;height:100%;object-fit:contain;display:block}
.ov-hit{box-shadow:0 0 0 2px #000 !important;transition:box-shadow .5s var(--ease)}
.ov-page--solo{max-width:520px;margin-left:auto;margin-right:auto}
.ov-page--solo img{height:auto;object-fit:initial}
/* 重组排版的章节(沙水交响) */
.ov-sec h3{
  font-family:var(--serif);font-size:17px;letter-spacing:.08em;
  margin:58px 0 16px;padding-top:36px;border-top:1px solid #ddd;
}
.ov-sec:first-child h3{margin-top:0;padding-top:0;border-top:none}
.ov-sec p{font-size:13px;color:#444;line-height:2.15;margin-bottom:10px}
/* 章首书法压题(海丝四程) */
.ov-sec h3.h-img{display:flex;align-items:center;gap:14px;flex-wrap:wrap}
.ov-sec h3.h-img img{height:26px;flex:0 0 auto}
.ov-sec h3.h-img .hs{font-size:12.5px;font-weight:400;color:var(--gray-2);letter-spacing:.14em}
/* 案例小标题(章节内的图文分组) */
.ov-sec h4.ov-st{font-family:var(--serif);font-size:14px;font-weight:700;letter-spacing:.08em;color:#20465e;margin:30px 0 12px}
.ov-sec p.ov-ln{margin-bottom:0}
.ov-sec p.ov-ln .ln{display:block;line-height:2.15;margin-bottom:.5em}
.ov-sec p.ov-ln .ln:last-child{margin-bottom:0}
/* 居中单图(海报等竖幅) */
.ov-fig{max-width:330px;margin:20px auto 6px;background:#fff;box-shadow:0 1px 3px rgba(0,0,0,.07);padding:10px}
.ov-fig img{width:100%;height:auto}
.ov-fig figcaption{font-size:11px;color:var(--gray-2);margin-top:9px;text-align:center;letter-spacing:.04em}
/* ===== 海丝 · 航海图航线(滚动驱动) ===== */
.chart-wrap{display:flex;gap:30px;margin:10px 0 30px;background:#fbfaf7;border:1px solid var(--line);padding:22px}
.chart-map{position:relative;flex:0 0 54%;align-self:flex-start}
.chart-map img{display:block;width:100%;height:auto}
.chart-map svg{position:absolute;inset:0;width:100%;height:100%}
.chart-route{fill:none;stroke:#a9bfc9;stroke-width:.42;stroke-dasharray:1.5 1.7}
.chart-draw{fill:none;stroke:#0d5f7e;stroke-width:.72;stroke-linecap:round}
.chart-port circle{fill:#fbfaf7;stroke:#a9bfc9;stroke-width:.55;transition:fill .5s,stroke .5s}
.chart-port.on circle{fill:#0d5f7e;stroke:#0d5f7e}
.chart-port text{font-family:var(--serif);paint-order:stroke;stroke:#fbfaf7;stroke-width:1;letter-spacing:.08em}
.chart-port .nm{font-size:3px;font-weight:700;fill:#8a949b;transition:fill .5s}
.chart-port.on .nm{fill:#0d5f7e}
.chart-port .pl{font-size:2.15px;fill:#8a949b}
.chart-boat{opacity:0;transition:opacity .35s}
.chart-boat.on{opacity:1}
.chart-legend{flex:1;display:flex;flex-direction:column;justify-content:center;gap:26px;min-width:0}
.chart-lg{opacity:.3;transition:opacity .55s}
.chart-lg.on{opacity:1}
.chart-lg img{height:20px;display:block;max-width:100%}
.chart-lg .cp{display:block;font-size:10.5px;color:var(--gray-2);margin-top:5px;letter-spacing:.05em;line-height:1.7}
@media(max-width:760px){.chart-wrap{flex-direction:column}.chart-legend{flex-direction:row;flex-wrap:wrap;gap:14px}.chart-lg{flex:1 1 40%}}
.ov-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:16px;margin:22px 0 8px}
.ov-grid figure{background:#fff;box-shadow:0 1px 3px rgba(0,0,0,.07);padding:10px}
.ov-grid img{width:100%}
.ov-grid figcaption{font-size:11px;color:var(--gray-2);margin-top:9px;text-align:center;letter-spacing:.04em}
.ov-grid--art figure{background:#fff;border:1px solid var(--line);box-shadow:none}
.ov-grid--art img{mix-blend-mode:multiply}
/* 资料图统一画框:等高、不裁切 */
.ov-grid--fix img{aspect-ratio:4/3;object-fit:contain;background:#f4f3ef}
.ov-grid--tall img{aspect-ratio:3/4}
.ov-grid figure[data-zoom]{cursor:zoom-in}
.ov-act{margin:34px 0 6px}
.ov-act .at{font-size:12px;font-weight:700;letter-spacing:.34em;margin-bottom:12px}
.ov-item{margin-bottom:22px}
.ov-item .iw{font-size:13.5px;font-weight:600;letter-spacing:.02em}
.ov-item .ia{font-size:12px;color:var(--gray-1);margin-left:10px}
.ov-item .id{font-size:12.5px;color:var(--gray-1);line-height:2.05;margin-top:5px}
/* 展项卡:图 + 编号作品名 + 作者 + 阐述 */
.act-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:18px;margin:16px 0 4px}
.act-card{background:#fff;box-shadow:0 1px 3px rgba(0,0,0,.07);padding:10px;display:flex;flex-direction:column}
.act-card img{width:100%;aspect-ratio:1/1;object-fit:contain;background:#f4f3ef;display:block}
.act-card figcaption{padding:13px 5px 5px;flex:1}
.act-card .iw{display:block;font-size:13.5px;font-weight:600;letter-spacing:.02em}
.act-card .ia{display:block;font-size:11.5px;color:var(--gray-2);margin-top:6px;letter-spacing:.08em}
.act-card .id{font-size:12.5px;color:var(--gray-1);line-height:2.05;margin-top:10px}
.ov-end{
  text-align:center;font-size:11px;color:var(--gray-2);
  letter-spacing:.18em;margin:64px 0 6px;line-height:2.4;
}
/* 阅读进度 */
.ov-counter{
  position:fixed;right:28px;bottom:22px;z-index:210;
  font-size:11px;letter-spacing:.12em;font-family:var(--sans);
  color:#fff;mix-blend-mode:difference;
}

/* ============ 罗马主题:复古手账信息图 ============ */
.overlay[data-theme="roma"]{
  background:#f7f0e1;
  background-image:
    radial-gradient(ellipse 46% 34% at 10% 6%, rgba(214,178,160,.34), transparent 70%),
    radial-gradient(ellipse 42% 30% at 92% 90%, rgba(176,203,219,.34), transparent 70%);
}
.overlay[data-theme="roma"] .ov-scroll{padding-top:92px}
.overlay[data-theme="roma"] .ov-info{max-width:660px;margin-bottom:16px}
.overlay[data-theme="roma"] .ov-info .t{color:#8f2727;font-size:23px;letter-spacing:.03em}
.overlay[data-theme="roma"] .ov-info .ty{color:#a8734f;letter-spacing:.22em}
.overlay[data-theme="roma"] .ov-info .m{color:#a8926f}
.overlay[data-theme="roma"] .ov-info .d{color:#5d5342}
.overlay[data-theme="roma"] .ov-flow{max-width:min(880px,94vw)}
.overlay[data-theme="roma"] .ov-sec h3{
  color:#8f2727;border-top:1px solid rgba(143,39,39,.18);
  font-size:17.5px;letter-spacing:.1em;
}
.overlay[data-theme="roma"] .ov-sec p{color:#514a3c}
.overlay[data-theme="roma"] .ov-end{color:#b09b7d}

/* 动态地图画布:纸纹底 + 描边 + 投影(保持原有质感) */
.rm-hero{display:flex;justify-content:center;margin:8px 0 14px}
.rm-map{
  position:relative;aspect-ratio:8/9;
  width:min(100%,calc((100dvh - 312px) * .889));
  background:#f2ecdd url('assets/roma-art/rm-paper.jpg') center/cover;
  border:1px solid rgba(143,39,39,.15);
  box-shadow:0 26px 64px -28px rgba(92,58,34,.45);
  container-type:inline-size;
}

/* 完整海报(左,主) + 动态地图(右,副):海报略大,地图略小,底边对齐,一屏看全 */
.rm-duo{
  --gap:clamp(34px,3.6vw,74px);
  --dw:min(1700px,calc(100vw - 76px));
  --ph:min(calc(100dvh - 300px),calc((var(--dw) - var(--gap)) / 1.4186));
  --mh:calc(var(--ph) * .8);
  display:flex;align-items:flex-end;justify-content:center;gap:var(--gap);
  width:var(--dw);margin-left:calc((100% - var(--dw)) / 2);
  margin-top:2px;margin-bottom:26px;
}
.rm-duo .rm-map{width:calc(var(--mh) * .889);height:var(--mh);aspect-ratio:auto}
.rm-duo .rm-poster{position:relative;width:calc(var(--ph) * .7074);cursor:zoom-in}
.rm-duo .rm-poster img{width:100%;display:block;box-shadow:0 22px 56px -26px rgba(92,58,34,.5)}
.rm-duo .rm-poster figcaption{
  position:absolute;top:100%;left:0;right:0;
  font-size:10px;color:#a1907a;letter-spacing:.14em;text-align:center;
  margin-top:6px;line-height:1.5;
}
.rm-bg{position:absolute;inset:0;will-change:transform}
.rm-bg img{position:absolute;display:block;transform:translate(-50%,-50%)}
/* 《用身体记得》封面画布:横版,粉色系纸纹,占满正文整栏宽 */
.rm-map.mm{
  aspect-ratio:1191/842;
  width:100%;
  background-image:url('assets/memory-art/mm-paper.jpg');
  border-color:rgba(160,105,105,.22);
  box-shadow:0 26px 64px -28px rgba(120,70,70,.42);
}
/* 静态元素(不参与悬浮/视差):文字层保持原位 */
.rm-el.still{cursor:default;pointer-events:none}
/* ===== 书籍感:版权页式页码 ===== */
/* 版权页式页码:小字 + 细线,页面进入视口中带时右下角浮现 */
.pgno{
  position:absolute;right:16px;bottom:12px;z-index:40;pointer-events:none;
  display:flex;align-items:center;gap:9px;
  opacity:0;transition:opacity .6s var(--ease);
}
.pgno i{display:block;width:30px;height:1px;background:#8a7565;opacity:.55}
.pgno span{font-size:9px;letter-spacing:.22em;color:#8a7565;white-space:nowrap}
.pgno.on{opacity:1}
/* ===== 全册总览:印刷总表式缩略图网格(点击跳页) ===== */
.ovt-grid{
  display:grid;grid-template-columns:repeat(5,1fr);gap:24px 20px;
  margin:6px 0 10px;
}
.ovt{
  margin:0;position:relative;cursor:pointer;background:#fff;padding:7px 7px 0;
  box-shadow:0 1px 2px rgba(60,40,30,.09),0 12px 24px -18px rgba(60,40,30,.5);
  transition:transform .5s var(--ease),box-shadow .5s var(--ease);
}
.ovt img{display:block;width:100%;aspect-ratio:1191/842;object-fit:cover;background:#f4f1ec}
.ovt-no{
  display:block;text-align:center;font-size:8.5px;letter-spacing:.22em;
  color:#8a7565;padding:6px 0 7px;margin-top:6px;
  border-top:1px solid rgba(138,117,101,.22);font-variant-numeric:tabular-nums;
}
.ovt:hover{
  transform:translateY(-4px);
  box-shadow:0 2px 4px rgba(60,40,30,.12),0 20px 36px -18px rgba(60,40,30,.55);
}
@media (max-width:920px){ .ovt-grid{grid-template-columns:repeat(3,1fr);gap:16px 14px} }
@media (max-width:560px){ .ovt-grid{grid-template-columns:repeat(2,1fr);gap:14px 12px} }
/* 叠压元素悬浮时不越级盖住上层(如花不能盖住爱心) */
.rm-map.mm .rm-el:hover{z-index:var(--hz,50)}
/* 正片叠底层:独立混合组,使纸色漂白后的裁片在任意底色上隐形 */
.rm-mul{position:absolute;inset:0;z-index:1;pointer-events:none;mix-blend-mode:multiply}
.rm-mul img{position:absolute;display:block;transform:translate(-50%,-50%)}
.rm-el{
  position:absolute;left:var(--x);top:var(--y);width:var(--w);
  transform:translate(-50%,-50%);z-index:var(--z,6);cursor:pointer;
}
.rm-el .pv{will-change:transform}
.rm-el .mv{animation:rm-bob var(--bd,4.4s) ease-in-out var(--bl,0s) infinite;will-change:transform}
.rm-el .fl{
  transition:transform .45s var(--ease),filter .45s var(--ease);
  filter:drop-shadow(0 3px 7px rgba(92,58,34,.16));
}
.rm-el:hover{z-index:50}
.rm-el:hover .fl{transform:translateY(-9px) scale(1.07);filter:drop-shadow(0 18px 22px rgba(92,58,34,.32))}
/* ---- 手账拼贴语言:悬浮=掀纸角(绕一角微旋+单侧投影),而非平行浮起 ---- */
.rm-map.mm .rm-el .pv{transform:rotate(var(--rot,0deg))}   /* 静态微旋:手工摆放不会全正 */
.rm-map.mm .rm-el .fl{transform-origin:76% 86%}
.rm-map.mm .rm-el:hover .fl{
  transform:rotate(calc(var(--rot,0deg) - 2.1deg)) translateY(-6px) scale(1.035);
  filter:drop-shadow(-9px 15px 15px rgba(92,58,34,.30)) drop-shadow(0 2px 4px rgba(92,58,34,.18));
}
.rm-map.mm .rm-el.still:hover .fl{transform:none;filter:none}
.rm-el img{width:100%;display:block}
.rm-el img.sq{background:#fbf7ec;border-radius:6px;box-shadow:0 3px 10px rgba(92,58,34,.2)}
.rm-el .nm{
  display:block;text-align:center;font-family:var(--serif);
  font-size:max(6.5px,1.7cqw);color:#5c4a33;letter-spacing:.06em;
  margin-top:2px;text-shadow:0 1px 0 #fff,0 -1px 0 #fff,1px 0 0 #fff,-1px 0 0 #fff,
    1px 1px 0 #fff,-1px -1px 0 #fff,1px -1px 0 #fff,-1px 1px 0 #fff;
  transition:color .35s var(--ease);white-space:nowrap;
}
.rm-el:hover .nm{color:#8f2727}
.rm-el.lab{cursor:default;width:auto}
