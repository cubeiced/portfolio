/* ============ 画布交互 ============ */
const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
const hasGSAP = typeof gsap !== 'undefined';
const isMobile = () => innerWidth <= 820;

/* 鼠标视差:深度差 10–45px(可重复绑定,先解绑旧的) */
let parallaxOff = null;
function bindParallax(){
  if (parallaxOff){ parallaxOff(); parallaxOff = null; }
  if (reduced || !hasGSAP || isMobile()) return;
  const setters = [...document.querySelectorAll('.space .item-inner')].map(el=>{
    const z = parseFloat(el.closest('.item').style.getPropertyValue('--z')||1);
    const depth = 0.008 + (z - 1) * 0.007;
    return {
      x: gsap.quickTo(el,'x',{duration:0.9,ease:'power3.out'}),
      y: gsap.quickTo(el,'y',{duration:0.9,ease:'power3.out'}),
      depth
    };
  });
  const onMove = e=>{
    const dx = e.clientX - innerWidth/2, dy = e.clientY - innerHeight/2;
    setters.forEach(s=>{ s.x(dx*s.depth); s.y(dy*s.depth); });
  };
  addEventListener('mousemove', onMove);
  parallaxOff = ()=>removeEventListener('mousemove', onMove);
}

/* 入场:yPercent 位移 + power4.out(不缩放);overwrite 用 auto,避免误杀视差 quickTo */
function pageIn(page){
  if (reduced || !hasGSAP) return;
  gsap.fromTo(`.space[data-page="${page}"] .item-inner`,
    {yPercent:60,opacity:0},
    {yPercent:0,opacity:1,duration:1.15,ease:'power4.out',stagger:0.055,overwrite:'auto'});
}
function pageOut(page,done){
  if (reduced || !hasGSAP){ done(); return; }
  gsap.to(`.space[data-page="${page}"] .item-inner`,
    {yPercent:-50,opacity:0,duration:0.42,ease:'power2.in',stagger:0.02,overwrite:'auto',onComplete:done});
}

/* 翻页 */
function gotoPage(p){
  if (document.body.dataset.page == p) return;
  hideOverlay(true);
  pageOut(document.body.dataset.page, ()=>{
    document.body.dataset.page = p;
    document.querySelectorAll('.pg').forEach(b=>b.classList.toggle('on', b.dataset.pg==p));
    if (p == 2) document.querySelector('.space[data-page="2"]').scrollTop = 0;
    pageIn(p);
    bindParallax(); /* 翻页后重建视差,确保新页元素跟鼠标 */
  });
}
document.querySelectorAll('.pg').forEach(b=>{
  b.addEventListener('click',()=>gotoPage(+b.dataset.pg));
});

